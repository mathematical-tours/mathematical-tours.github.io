{
  "templates": [
    "_config.yml", "Gemfile", "_data/*.json", "_includes/*.html", "_layouts/*.html",
    "index.md", "book.md", "daft.md", "book-basics.md", "algorithms.md", "slides.md",
    "maths-ia-course.md", "tweets.md", "tweets_main.md", "tweets_oldies.md", "404.html"
  ],
  "assets": [
    "css/*.css", "js/*.js", "fonts/*", "img/*.svg", "img/*-cover.webp",
    "img/louis-peyre/*.jpg", "img/previews/*", "img/slides/*.jpg",
    "book-sources/FundationsDataScience.pdf", "book-sources/chapters-pdf/*.pdf",
    "book-sources/aux/optim-ml/OptimML.pdf", "book-sources/aux/optim-ml/OptimML-DiffusionModels.pdf",
    "book-basics-sources/IntroImaging.pdf", "book-basics-sources/IntroImaging-FR.pdf",
    "book-basics-sources/chapters-pdf/en/*.pdf", "book-basics-sources/chapters-pdf/fr/*.pdf",
    "book-basics-sources/ot-sources/TransportEN.pdf", "book-basics-sources/ot-sources/TransportFR.pdf",
    "book-basics-sources/neural-networks-en/NeuralNetworksEN.pdf",
    "book-basics-sources/neural-networks/NeuralNetworksFR.pdf",
    "daft-sources/DAFT-EN.pdf", "daft-sources/comparator-figures/comparison.pdf",
    "daft-sources/downloads/daft-python.zip",
    "maths-ia-course-data/material/*.pdf", "maths-ia-course-data/material/*.ipynb",
    "maths-ia-course-data/transcripts/*.pdf"
  ],
  "reader_manifest": "book/interactive/publication.json",
  "maximum_bytes": 600000000,
  "maximum_files": 5000
}
